# Azure Subscription and Tenant
AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_TENANT_ID=your-tenant-id
AZURE_RESOURCE_GROUP=your-resource-group

# Azure AI Search Configuration
AZURE_SEARCH_SERVICE=your-search-service-name
AZURE_SEARCH_INDEX=your-index-name

# Azure OpenAI Configuration
OPENAI_HOST=azure
AZURE_OPENAI_SERVICE=your-openai-service-name
AZURE_OPENAI_ENDPOINT=https://your-openai-service.openai.azure.com/
AZURE_OPENAI_API_KEY_OVERRIDE=your-openai-api-key
AZURE_OPENAI_CHATGPT_MODEL=gpt-4
AZURE_OPENAI_CHATGPT_DEPLOYMENT=gpt-4-deployment

# Azure OpenAI Embeddings Configuration
AZURE_OPENAI_EMB_MODEL_NAME=text-embedding-3-small
AZURE_OPENAI_EMB_DEPLOYMENT=text-embedding-deployment
AZURE_OPENAI_EMB_DIMENSIONS=1536

# Azure Document Intelligence Configuration
AZURE_DOCUMENTINTELLIGENCE_SERVICE=your-document-intelligence-service
AZURE_DOCUMENTINTELLIGENCE_ENDPOINT=https://your-document-intelligence-service.cognitiveservices.azure.com/

# Optional: Use local PDF/HTML parsers instead of Document Intelligence
USE_LOCAL_PDF_PARSER=false
USE_LOCAL_HTML_PARSER=false

# Multimodal/Figure Processing Configuration
USE_MULTIMODAL=true
AZURE_VISION_ENDPOINT=https://your-vision-service.cognitiveservices.azure.com/

# Content Understanding (Optional, for advanced image description)
USE_MEDIA_DESCRIBER_AZURE_CU=false
AZURE_CONTENTUNDERSTANDING_ENDPOINT=https://your-content-understanding-service.cognitiveservices.azure.com/

# Optional: Custom Azure OpenAI endpoint
AZURE_OPENAI_CUSTOM_URL=

# Optional: OpenAI configuration (if not using Azure OpenAI)
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
